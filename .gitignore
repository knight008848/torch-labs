# Large raw datasets -- never commit (robomimic image.hdf5 is ~1.5GB)
data/raw/*
!data/raw/.gitkeep

# Model checkpoints (large binaries)
models/*
!models/.gitkeep

# NOTE: docs/figs/ is intentionally tracked -- BENCHMARK.md and REPORT.md
# embed these figures, so ignoring them would break images on GitHub.

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
# Build artifacts from `pip install -e .` (see pyproject.toml)
*.egg-info/
build/
dist/

# Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# Claude Code project-local config -- personal machine state, never shared.
# settings.local.json holds per-machine permission grants, not project policy,
# and can accumulate machine-specific paths. Repo-level rule so it holds on any
# clone, independent of the global ~/.config/git/ignore on this WSL box.
# NOTE: if shared agent definitions (.claude/agents/) are ever added, place a
# negation rule for them above this line -- see dsh-skills-deepdive.
.claude/
