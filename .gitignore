# Large raw datasets -- never commit (robomimic image.hdf5 is ~1.5GB)
data/raw/*
!data/raw/.gitkeep

# Model checkpoints (large binaries)
models/*
!models/.gitkeep

# NOTE: docs/figs/ is intentionally tracked -- BENCHMARK.md and REPORT.md
# embed these figures, so ignoring them would break images on GitHub.

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
